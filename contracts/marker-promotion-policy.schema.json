{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/marker-promotion-policy.schema.json",
  "title": "AEGIS Marker Promotion Policy Contract",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "applies_to",
    "states",
    "reviewer_model",
    "working_parameters"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "policy_id": { "type": "string", "minLength": 1 },
    "applies_to": {
      "type": "object",
      "required": ["contract"],
      "properties": {
        "contract": { "type": "string" },
        "marker_glob": { "type": "string" }
      },
      "additionalProperties": false
    },
    "states": {
      "type": "object",
      "required": ["reviewed", "verified"],
      "properties": {
        "reviewed": { "$ref": "#/$defs/threshold" },
        "verified": { "$ref": "#/$defs/threshold" }
      },
      "additionalProperties": false
    },
    "reviewer_model": {
      "type": "object",
      "required": ["builder_reviewers", "full_redundancy_target"],
      "properties": {
        "builder_reviewers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "full_redundancy_target": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "working_parameters": {
      "type": "object",
      "required": ["scope", "pod_state_effect", "live_reach"],
      "properties": {
        "scope": { "type": "string" },
        "pod_state_effect": { "type": "string" },
        "live_reach": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "threshold": {
      "type": "object",
      "required": [
        "min_independent_reviewers",
        "required_review_results",
        "require_all_commands_pass",
        "require_current_hashes",
        "require_claim_boundary",
        "live_reach_allowed"
      ],
      "properties": {
        "min_independent_reviewers": { "type": "integer", "minimum": 1 },
        "required_review_results": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["pending", "no_blocking_objection", "needs_revision"]
          }
        },
        "require_all_commands_pass": { "type": "boolean" },
        "require_current_hashes": { "type": "boolean" },
        "require_claim_boundary": { "type": "boolean" },
        "live_reach_allowed": { "type": "boolean" },
        "required_reviewer_evidence": {
          "type": "object",
          "properties": {
            "peer_review_message_hashes": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
