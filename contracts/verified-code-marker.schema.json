{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/verified-code-marker.schema.json",
  "title": "AEGIS Verified Code Marker Contract",
  "type": "object",
  "required": [
    "schema_version",
    "marker_id",
    "target",
    "version_identity",
    "standard_hash",
    "hashes",
    "verification",
    "reviews",
    "claim_boundary",
    "working_parameters",
    "trust_state"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "marker_id": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["pod", "orb", "umbilical", "tensor_runtime"]
        },
        "id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "version_identity": { "type": "string" },
    "standard_hash": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "hashes": {
      "type": "object",
      "required": ["schema_hash", "implementation_hash", "demo_hash", "test_result_hash"],
      "properties": {
        "schema_hash": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "implementation_hash": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "demo_hash": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "test_result_hash": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["commands", "evidence_paths", "live_reach"],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["command", "result"],
            "properties": {
              "command": { "type": "string" },
              "result": {
                "type": "string",
                "enum": ["pass", "fail", "not_run"]
              }
            },
            "additionalProperties": false
          }
        },
        "evidence_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "live_reach": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reviewer", "timestamp_utc", "result", "notes", "evidence"],
        "properties": {
          "reviewer": { "type": "string" },
          "timestamp_utc": { "type": "string" },
          "result": {
            "type": "string",
            "enum": ["pending", "no_blocking_objection", "needs_revision"]
          },
          "notes": { "type": "string" },
          "evidence": {
            "type": "object",
            "required": ["kind", "message_hashes"],
            "properties": {
              "kind": { "type": "string" },
              "message_hashes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-F0-9]{64}$"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "claim_boundary": {
      "type": "object",
      "required": ["demonstrates", "outside_current_verified_surface"],
      "properties": {
        "demonstrates": {
          "type": "array",
          "items": { "type": "string" }
        },
        "outside_current_verified_surface": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "trust_state": {
      "type": "string",
      "enum": ["draft", "provisional", "reviewed", "verified"]
    },
    "working_parameters": {
      "type": "object",
      "required": ["scope", "pod_state_effect", "outside_parameters_behavior"],
      "properties": {
        "scope": { "type": "string" },
        "pod_state_effect": { "type": "string" },
        "outside_parameters_behavior": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
