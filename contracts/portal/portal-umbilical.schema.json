{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/portal-umbilical.schema.json",
  "title": "AEGIS Portal Umbilical Contract",
  "type": "object",
  "required": ["schema_version", "umbilical_id", "pod_id", "orb_id", "allowed_capabilities", "allowed_scopes", "prohibited_capabilities", "mutation_authority", "admission_authority", "experience_authority"],
  "properties": {
    "schema_version": {"type": "string"},
    "umbilical_id": {"type": "string", "minLength": 1},
    "pod_id": {"type": "string", "minLength": 1},
    "orb_id": {"type": "string", "minLength": 1},
    "allowed_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "allowed_scopes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "prohibited_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "mutation_authority": {"const": false},
    "admission_authority": {"const": false},
    "experience_authority": {"const": false}
  },
  "additionalProperties": false
}
