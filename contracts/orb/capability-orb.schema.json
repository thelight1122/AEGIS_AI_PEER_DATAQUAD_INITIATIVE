{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/capability-orb.schema.json",
  "title": "AEGIS Capability Orb Contract",
  "type": "object",
  "required": ["schema_version", "orb_id", "orb_class", "enabled", "capabilities", "writes"],
  "properties": {
    "schema_version": {"type": "string"},
    "orb_id": {"type": "string", "minLength": 1},
    "orb_class": {"const": "capability"},
    "enabled": {"const": false},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "minItems": 1},
    "writes": {"type": "object", "required": ["authoritative_tensors", "derived_ledgers"], "properties": {"authoritative_tensors": {"const": false}, "derived_ledgers": {"const": true}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
