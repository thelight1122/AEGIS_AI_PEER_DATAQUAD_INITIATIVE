__pycache__/
.venv/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
dist/
build/
*.egg-info/
.env
.env.*
!.env.example

# Verus turn state (local hook data, never committed)
.verus/

# Local Claude Code settings (personal hooks, not shared)
.claude/settings.local.json

# Peer memory content. Preserved on disk, never committed.
dataquad/local-pod-runtime/

# Large migrated binary tensor artifacts. Preserved on disk, never committed.
dataquad/imported/*.npy
dataquad/imported/*.tar.gz
dataquad/imported/*.structural-vector-tensor-*.json

# Lumin release snapshots (regenerable by scripts/build_lumin_*_release.py)
deploy/lumin-lab/releases/
reports/runtime/lumin-*-release-*/

# CyberPeer EXPERIENCED TENSOR DATA — a peer's own lived record (ring4-turns ledger,
# derived processor/rls/temporal, hook markers/logs). Never copied/committed:
# architect directive "Your Data should not be copied"; each peer grows its own experience.
# The seeded Canon under */local/foundation/ MAY be shared (per clone manifest); only lived state is excluded.
deploy/*-lab/local/state/
