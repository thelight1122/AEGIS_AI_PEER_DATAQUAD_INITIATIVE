+++ b/core/dataquad/relations.py
@@ -0,0 +1,68 @@
+"""Persistent relation recording for the canonical Pod (Stage D2).
+
+This function was ABSENT from Orion's pre-Pod runtime - a Catastrophic Drift
+finding: persistent relation recording existed only on Gabe, while Orion carried
+the custodian ledgers without it. It is implemented here in the canonical core so
+every peer converging on the Pod records relations identically, closing that
+drift at the code layer.
+
+Entry schemas match the shapes observed on Gabe's live recorder:
+  traversal:      {action, append_only, id, record_id, source, tensor, timestamp}
+  cross-tensor:   {id, relation, source, target, t, tags, timestamp, written_by}
+
+All writes are gated by pod.rls_active(): nothing is written until the D3 live
+switch activates RLS. Before that, every method is a no-op.
+"""
+from __future__ import annotations
+
+from datetime import datetime, timezone
+from pathlib import Path
+
+import aiofiles
+
+from core.dataquad import pod as _pod
+
+
+def _now() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+class RelationsRecorder:
+    async def _append(self, path: Path, entry: dict) -> None:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        async with aiofiles.open(path, mode="a", encoding="utf-8") as handle:
+            await handle.write(_pod.stable_json(entry) + "\n")
+
+    async def record_append(self, peer_root: Path, tensor: str, body: dict) -> None:
+        """Append a traversal entry for each record append. No-op until active."""
+        if not _pod.rls_active():
+            return
+        record_id = str(body.get("id", ""))
+        entry = {
+            "action": "append",
+            "append_only": True,
+            "id": f"trav:{tensor}:{record_id}",
+            "record_id": record_id,
+            "source": "pod-runtime",
+            "tensor": tensor,
+            "timestamp": _now(),
+        }
+        await self._append(_pod.relations_dir(peer_root) / f"{tensor}-traversal.jsonl", entry)
+
+    async def record_cross_tensor(self, peer_root: Path, source_id: str, target_id: str,
+                                  relation: str, tags: list[str] | None = None,
+                                  written_by: str = "rls-engine") -> None:
+        """Append a cross-tensor relation entry. No-op until active."""
+        if not _pod.rls_active():
+            return
+        entry = {
+            "id": f"rel:{source_id}->{target_id}:{relation}",
+            "relation": relation,
+            "source": source_id,
+            "target": target_id,
+            "t": _now(),
+            "tags": tags or [],
+            "timestamp": _now(),
+            "written_by": written_by,
+        }
+        await self._append(_pod.relations_dir(peer_root) / "cross-tensor-relations.jsonl", entry)
