diff --git a/tests/test_pod_runtime.py b/tests/test_pod_runtime.py
new file mode 100644
index 0000000..e8ba9c6
--- /dev/null
+++ b/tests/test_pod_runtime.py
@@ -0,0 +1,175 @@
+"""Stage D2 tests: Pod-aware runtime storage.
+
+Covers the load-bearing D2 behaviours: legacy/pod path resolution, reader
+unwrapping of contract records, writer wrapping with hash-chain continuity, and
+the real RLS activation gate (relations recording is inert until activated).
+"""
+import asyncio
+import json
+import os
+import unittest
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+from core.dataquad import pod as _pod
+from core.dataquad import stm as _stm
+from core.dataquad.ledgers import DataQuadStore
+from core.dataquad.records import PEERRecord, ContinuityClock
+from core.dataquad.tensors import TensorKind
+
+PEER_ID = "CP-TEST"
+
+
+def _clock():
+    return ContinuityClock(tick=1, started_at="2026-07-21T00:00:00Z", last_advanced_at="2026-07-21T00:00:00Z")
+
+
+def _peer_record(rid: str) -> PEERRecord:
+    return PEERRecord(id=rid, timestamp="2026-07-21T00:00:00Z", session_id="s", clock=_clock(),
+                      present_state={"note": rid})
+
+
+class _Env:
+    def __init__(self, **kv):
+        self.kv = kv
+        self.prev = {}
+
+    def __enter__(self):
+        for k, v in self.kv.items():
+            self.prev[k] = os.environ.get(k)
+            if v is None:
+                os.environ.pop(k, None)
+            else:
+                os.environ[k] = v
+
+    def __exit__(self, *a):
+        for k, v in self.prev.items():
+            if v is None:
+                os.environ.pop(k, None)
+            else:
+                os.environ[k] = v
+
+
+class PodRuntimeTest(unittest.TestCase):
+    def setUp(self):
+        # The STM cache is a module-level global keyed by (peer_id, tensor). Evict
+        # this test peer before each test so cross-test cache state cannot leak.
+        _stm.evict(PEER_ID)
+
+    def test_path_resolution_legacy_vs_pod(self):
+        root = Path("/x/peers/CP-TEST")
+        with _Env(AEGIS_STORAGE_MODE="legacy"):
+            self.assertTrue(str(_pod.records_dir(root)).endswith(os.path.join("CP-TEST", "dataquad")))
+            self.assertTrue(str(_pod.ledgers_dir(root)).endswith(os.path.join("CP-TEST", "ledgers")))
+        with _Env(AEGIS_STORAGE_MODE="pod"):
+            self.assertTrue(str(_pod.records_dir(root)).endswith(os.path.join("pod", "records")))
+            self.assertTrue(str(_pod.ledgers_dir(root)).endswith(os.path.join("pod", "ledgers")))
+
+    def test_pod_write_wraps_and_read_unwraps(self):
+        with TemporaryDirectory() as tmp, _Env(AEGIS_STORAGE_MODE="pod", AEGIS_RLS_ACTIVE="false"):
+            store = DataQuadStore(data_dir=tmp)
+            asyncio.run(store.append_record(PEER_ID, _peer_record("PEER:1")))
+            # On disk: a wrapped contract record under pod/records/, raw record in body.
+            path = Path(tmp) / "peers" / PEER_ID / "pod" / "records" / "PEER.jsonl"
+            self.assertTrue(path.exists())
+            line = json.loads(path.read_text(encoding="utf-8").strip())
+            self.assertIn("body", line)
+            self.assertIn("source_hash", line)
+            self.assertEqual(line["body"]["id"], "PEER:1")
+            self.assertEqual(line["migration_status"], "live")
+            # Read back: a fresh store (cold STM) returns the unwrapped raw record.
+            store2 = DataQuadStore(data_dir=tmp)
+            records = asyncio.run(store2.read_records(PEER_ID, TensorKind.PEER))
+            self.assertEqual(len(records), 1)
+            self.assertEqual(records[0].id, "PEER:1")
+
+    def test_hash_chain_continuity_across_appends(self):
+        with TemporaryDirectory() as tmp, _Env(AEGIS_STORAGE_MODE="pod", AEGIS_RLS_ACTIVE="false"):
+            store = DataQuadStore(data_dir=tmp)
+            asyncio.run(store.append_record(PEER_ID, _peer_record("PEER:1")))
+            asyncio.run(store.append_record(PEER_ID, _peer_record("PEER:2")))
+            path = Path(tmp) / "peers" / PEER_ID / "pod" / "records" / "PEER.jsonl"
+            lines = [json.loads(x) for x in path.read_text(encoding="utf-8").splitlines() if x.strip()]
+            self.assertEqual(lines[0]["lineage"]["previous_record_hash"], "")
+            # Second record chains to the first record's source_hash - unbroken lineage.
+            self.assertEqual(lines[1]["lineage"]["previous_record_hash"], lines[0]["source_hash"])
+
+    def test_rls_gate_controls_relation_recording(self):
+        relations = Path()
+        with TemporaryDirectory() as tmp:
+            # Inactive: append writes NO relation ledger.
+            with _Env(AEGIS_STORAGE_MODE="pod", AEGIS_RLS_ACTIVE="false"):
+                store = DataQuadStore(data_dir=tmp)
+                asyncio.run(store.append_record(PEER_ID, _peer_record("PEER:1")))
+                relations = Path(tmp) / "peers" / PEER_ID / "pod" / "ledgers" / "relations"
+                self.assertFalse(relations.exists() and any(relations.glob("*.jsonl")))
+            # Active: append writes a traversal relation entry.
+            with _Env(AEGIS_STORAGE_MODE="pod", AEGIS_RLS_ACTIVE="true"):
+                store = DataQuadStore(data_dir=tmp)
+                asyncio.run(store.append_record(PEER_ID, _peer_record("PEER:2")))
+                trav = relations / "PEER-traversal.jsonl"
+                self.assertTrue(trav.exists())
+                entry = json.loads(trav.read_text(encoding="utf-8").strip())
+                self.assertEqual(entry["record_id"], "PEER:2")
+                self.assertEqual(entry["action"], "append")
+
+    def test_legacy_mode_unchanged(self):
+        with TemporaryDirectory() as tmp, _Env(AEGIS_STORAGE_MODE="legacy"):
+            store = DataQuadStore(data_dir=tmp)
+            asyncio.run(store.append_record(PEER_ID, _peer_record("PEER:1")))
+            legacy = Path(tmp) / "peers" / PEER_ID / "dataquad" / "PEER.jsonl"
+            self.assertTrue(legacy.exists())
+            line = json.loads(legacy.read_text(encoding="utf-8").strip())
+            # Legacy write is the raw record, NOT wrapped.
+            self.assertNotIn("body", line)
+            self.assertEqual(line["id"], "PEER:1")
+
+    def test_reads_migration_tool_wrapper_shape(self):
+        # Locks migration<->runtime compatibility: a record written in the Stage B
+        # MIGRATION TOOL's wrapper shape (a different codebase) must read cleanly
+        # through the runtime reader. This is the gate whose absence let a boot-fail
+        # risk go unproven; a mismatch here would fail Orion's startup.
+        migrated_line = {
+            "schema_version": "0.1.0",
+            "tensor": "PEER",
+            "record_id": "PEER:mig:1",
+            "source_record_id": "PEER:mig:1",
+            "timestamp_utc": "2026-07-21T00:00:00Z",
+            "body": {
+                "id": "PEER:mig:1", "timestamp": "2026-07-21T00:00:00Z", "tensor": "PEER",
+                "session_id": "s", "clock": {"tick": 3, "started_at": "2026-07-21T00:00:00Z",
+                "last_advanced_at": "2026-07-21T00:00:00Z"}, "present_state": {"k": "v"},
+            },
+            "lineage": {"origin": "live-copy CP-1004-ORION", "source_path": "x", "copy_batch_id": "b",
+                        "parent_record_id": "", "previous_record_hash": "", "transforms": []},
+            "source_hash": "A" * 64, "source_hash_scope": "normalized_source_record",
+            "migration_status": "copied", "verification_status": "draft",
+        }
+        with TemporaryDirectory() as tmp, _Env(AEGIS_STORAGE_MODE="pod"):
+            recs_dir = Path(tmp) / "peers" / PEER_ID / "pod" / "records"
+            recs_dir.mkdir(parents=True)
+            (recs_dir / "PEER.jsonl").write_text(json.dumps(migrated_line) + "\n", encoding="utf-8")
+            store = DataQuadStore(data_dir=tmp)
+            recs = asyncio.run(store.read_records(PEER_ID, TensorKind.PEER))
+            self.assertEqual(len(recs), 1)
+            self.assertEqual(recs[0].id, "PEER:mig:1")  # unwrapped from body
+            self.assertEqual(recs[0].clock.tick, 3)
+
+    def test_malformed_record_is_skipped_not_fatal(self):
+        # A single unreadable line must not abort the read (which on the bootstrap
+        # path would take the service down). Good records around it still load.
+        with TemporaryDirectory() as tmp, _Env(AEGIS_STORAGE_MODE="pod"):
+            store = DataQuadStore(data_dir=tmp)
+            asyncio.run(store.append_record(PEER_ID, _peer_record("PEER:ok1")))
+            path = Path(tmp) / "peers" / PEER_ID / "pod" / "records" / "PEER.jsonl"
+            with path.open("a", encoding="utf-8") as handle:
+                handle.write('{"body": {"id": "bad", "tensor": "PEER"}, "source_hash": "x"}\n')  # invalid record
+            asyncio.run(store.append_record(PEER_ID, _peer_record("PEER:ok2")))
+            store2 = DataQuadStore(data_dir=tmp)  # cold read from disk
+            recs = asyncio.run(store2.read_records(PEER_ID, TensorKind.PEER))
+            ids = {r.id for r in recs}
+            self.assertEqual(ids, {"PEER:ok1", "PEER:ok2"})  # bad line skipped, good ones survive
+
+
+if __name__ == "__main__":
+    unittest.main()
