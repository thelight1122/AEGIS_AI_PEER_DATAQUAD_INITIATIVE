new file mode 100644
index 0000000..183fc95
--- /dev/null
+++ b/core/dataquad/pod.py
@@ -0,0 +1,137 @@
+"""Pod-mode storage adapter for the DataQuadPod canonical structure (Stage D2).
+
+Governing doctrine: the DataQuad IS the Pod. When AEGIS_STORAGE_MODE=pod, the
+runtime reads and writes the peer's canonical Pod instead of the legacy layout:
+
+    peers/<id>/pod/records/<T>.jsonl              canonical tensor-record stores
+    peers/<id>/pod/ledgers/<name>.jsonl           custodian ledgers
+    peers/<id>/pod/ledgers/relations/*.jsonl      persistent relation ledgers
+
+Pod records are contract-shaped tensor-records that carry the original raw record
+verbatim in `body`, so existing cognition sees identical data after unwrapping.
+Legacy mode (the default) preserves the original dataquad/ + ledgers/ layout, so
+the switch is reversible by configuration alone. Mode detection never mutates any
+file; only the resolved paths and the read/write wrapping differ.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+from typing import Any
+
+POD_SCHEMA_VERSION = "0.1.0"
+SOURCE_HASH_SCOPE = "normalized_source_record"
+
+
+def storage_mode() -> str:
+    return os.getenv("AEGIS_STORAGE_MODE", "legacy").strip().lower()
+
+
+def is_pod_mode() -> bool:
+    return storage_mode() == "pod"
+
+
+def rls_active() -> bool:
+    """Real behaviour gate for persistent RLS / relation recording.
+
+    Distinct from ENABLE_RLS, which only affects the /health display. This gate
+    actually controls whether relation recording writes. Activated after the D3
+    live switch, never before.
+    """
+    return os.getenv("AEGIS_RLS_ACTIVE", "false").strip().lower() == "true"
+
+
+def records_dir(peer_root: Path) -> Path:
+    return peer_root / "pod" / "records" if is_pod_mode() else peer_root / "dataquad"
+
+
+def ledgers_dir(peer_root: Path) -> Path:
+    return peer_root / "pod" / "ledgers" if is_pod_mode() else peer_root / "ledgers"
+
+
+def relations_dir(peer_root: Path) -> Path:
+    return peer_root / "pod" / "ledgers" / "relations"
+
+
+def pod_manifest_path(peer_root: Path) -> Path:
+    return peer_root / "pod" / "pod-manifest.json"
+
+
+def stable_json(data: Any) -> str:
+    return json.dumps(data, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+
+
+def sha256_upper(text: str) -> str:
+    return hashlib.sha256(text.encode("utf-8")).hexdigest().upper()
+
+
+def is_wrapped(obj: Any) -> bool:
+    return isinstance(obj, dict) and "body" in obj and "source_hash" in obj
+
+
+def unwrap(obj: dict) -> dict:
+    """Return the raw DataQuad record. Pod records carry it in `body`; legacy
+    records are already raw. Defensive so a mixed file cannot crash the reader.
+    """
+    if is_wrapped(obj):
+        body = obj.get("body")
+        return body if isinstance(body, dict) else {}
+    return obj
+
+
+def last_source_hash(path: Path) -> str:
+    """source_hash of the last record already stored in a pod records file, used
+    to chain the next appended record so the live lineage continues unbroken from
+    the last migrated record. Empty when the file is absent or empty.
+    """
+    if not path.exists():
+        return ""
+    last = ""
+    with path.open("r", encoding="utf-8") as handle:
+        for line in handle:
+            line = line.strip()
+            if not line:
+                continue
+            try:
+                obj = json.loads(line)
+            except Exception:
+                continue
+            value = obj.get("source_hash")
+            if value:
+                last = str(value)
+    return last
+
+
+def wrap(body: dict, tensor: str, previous_source_hash: str,
+         origin: str = "live-append", copy_batch_id: str = "live-append") -> dict:
+    """Wrap a raw record into a canonical Pod tensor-record.
+
+    source_hash is the SHA256 of the stable JSON of the raw record (the same
+    convention the Stage B migration used), and previous_record_hash chains to the
+    prior stored record - so a record appended live continues the same hash chain
+    that began at the first migrated record.
+    """
+    source_hash = sha256_upper(stable_json(body))
+    record_id = str(body.get("id", ""))
+    return {
+        "schema_version": POD_SCHEMA_VERSION,
+        "tensor": tensor,
+        "record_id": record_id,
+        "source_record_id": record_id,
+        "timestamp_utc": str(body.get("timestamp", "")),
+        "body": body,
+        "lineage": {
+            "origin": origin,
+            "source_path": "",
+            "copy_batch_id": copy_batch_id,
+            "parent_record_id": "",
+            "previous_record_hash": previous_source_hash,
+            "transforms": [],
+        },
+        "source_hash": source_hash,
+        "source_hash_scope": SOURCE_HASH_SCOPE,
+        "migration_status": "live",
+        "verification_status": "draft",
+    }
diff --git a/core/dataquad/relations.py b/core/dataquad/relations.py
