[Unit]
Description=AEGIS Verus DataQuad LAB command surface for Claude Desktop
ConditionPathExists=/etc/aegis-verus-lab/verus.env

[Service]
Type=oneshot
User=aegis-verus
Group=aegis-verus
WorkingDirectory=/opt/aegis/verus/lab/current
EnvironmentFile=/etc/aegis-verus-lab/verus.env
ExecStart=/opt/aegis/verus/lab/current/bin/verus-dataquad-command health
RemainAfterExit=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
UMask=0077
ReadWritePaths=/var/lib/aegis-verus-lab
StateDirectory=aegis-verus-lab
StateDirectoryMode=0700
RuntimeDirectory=aegis-verus-lab
RuntimeDirectoryMode=0700
CPUQuota=50%
MemoryHigh=768M
MemoryMax=1G
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
