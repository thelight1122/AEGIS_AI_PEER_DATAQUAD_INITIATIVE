[Unit]
Description=AEGIS Verus DataQuad LAB on Claude Frontier substrate
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/aegis-verus-lab/verus.env

[Service]
Type=simple
User=aegis-verus
Group=aegis-verus
WorkingDirectory=/opt/aegis/verus/lab/current
EnvironmentFile=/etc/aegis-verus-lab/verus.env
LoadCredential=anthropic_api_key:/etc/aegis-verus-lab/secrets/anthropic-api-key
LoadCredential=bridge_token:/etc/aegis-verus-lab/secrets/bridge-token
ExecStart=/opt/aegis/verus/lab/current/bin/aegis-verus-lab --release-root /opt/aegis/verus/lab/current/foundation --state-root /var/lib/aegis-verus-lab --model ${AEGIS_FRONTIER_MODEL} --anthropic-credential-file ${CREDENTIALS_DIRECTORY}/anthropic_api_key --bridge-credential-file ${CREDENTIALS_DIRECTORY}/bridge_token --host ${AEGIS_BIND} --port ${AEGIS_PORT}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
ReadWritePaths=/var/lib/aegis-verus-lab
StateDirectory=aegis-verus-lab
StateDirectoryMode=0700
RuntimeDirectory=aegis-verus-lab
RuntimeDirectoryMode=0700
CPUQuota=50%
MemoryHigh=768M
MemoryMax=1G
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
