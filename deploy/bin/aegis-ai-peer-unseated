#!/usr/bin/env python3
"""Fail-closed localhost health endpoint for an unseated AI Peer."""
import argparse
import json
import os
from pathlib import Path
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PEERS = {"lumin", "claude", "gemini", "grok"}

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path not in {"/health", "/status"}:
            self.send_error(404); return
        body = json.dumps({"peer": self.server.peer, "mode": "UNSEATED",
            "ready": False, "live_source": False, "source_mode": "none",
            "writes_enabled": False}, sort_keys=True).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers(); self.wfile.write(body)
    def do_POST(self):
        self.send_error(405, "UNSEATED instances have no write endpoint")
    def log_message(self, fmt, *args):
        print(f"{self.server.peer}: {fmt % args}", flush=True)

def main():
    p = argparse.ArgumentParser()
    p.add_argument("--peer", required=True)
    p.add_argument("--state-root", required=True)
    p.add_argument("--bind", default=os.environ.get("AEGIS_BIND", "127.0.0.1"))
    p.add_argument("--port", type=int, default=int(os.environ.get("AEGIS_PORT", "0")))
    a = p.parse_args()
    if a.peer not in PEERS: p.error("invalid peer")
    if not a.port: p.error("non-zero loopback port required")
    if a.bind not in {"127.0.0.1", "::1", "localhost"}: p.error("loopback binding required")
    root = Path(a.state_root).resolve()
    expected = Path("/var/lib/aegis-ai-peers") / a.peer
    if root != expected: p.error(f"state root must be {expected}")
    root.mkdir(parents=True, exist_ok=True)
    (root / "MODE").write_text("UNSEATED\n", encoding="ascii")
    server = ThreadingHTTPServer((a.bind, a.port), Handler)
    server.peer = a.peer
    server.serve_forever()

if __name__ == "__main__":
    main()
